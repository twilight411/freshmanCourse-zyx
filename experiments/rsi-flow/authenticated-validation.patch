diff --git a/flow-test/src/test/java/cc/eamon/open/flow/FLOW_AGENT_LONG/FlowLongAgentTest.java b/flow-test/src/test/java/cc/eamon/open/flow/FLOW_AGENT_LONG/FlowLongAgentTest.java
new file mode 100644
index 0000000..8dd874d
--- /dev/null
+++ b/flow-test/src/test/java/cc/eamon/open/flow/FLOW_AGENT_LONG/FlowLongAgentTest.java
@@ -0,0 +1,91 @@
+package cc.eamon.open.flow.FLOW_AGENT_LONG;
+
+import cc.eamon.open.flow.config.constants.FlowConstants;
+import cc.eamon.open.flow.core.FlowEngine;
+import cc.eamon.open.flow.code.FlowLongAgentCode;
+import org.testng.Assert;
+import org.testng.annotations.Test;
+import java.util.Arrays;
+
+public class FlowLongAgentTest {
+    private static final String[] SHORT = {"AGENT_ROUTE", "AGENT_SHORT", "AGENT_VERIFY"};
+    private static final String[] LONG = {"AGENT_ROUTE", "AGENT_CHUNK", "AGENT_DRAFT", "AGENT_VERIFY"};
+
+    @Test public void shortSequentialPath() throws Exception {
+        check("key: value\n", "key", "key: value", SHORT);
+    }
+
+    @Test public void longNestedPathOver100k() throws Exception {
+        check(repeat("noise\n", 22000) + "needle: result\n", "needle", "needle: result", LONG);
+    }
+
+    @Test public void exact4096UsesShortBranch() throws Exception {
+        check("key: value\n" + repeat("x", 4085), "key", "key: value", SHORT);
+    }
+
+    @Test public void above4096UsesNestedBranch() throws Exception {
+        check("key: value\n" + repeat("x", 4086), "key", "key: value", LONG);
+    }
+
+    @Test public void missingEvidenceShort() throws Exception {
+        check("noise\n", "needle", "NOT_FOUND", SHORT);
+    }
+
+    @Test public void missingEvidenceLong() throws Exception {
+        check(repeat("noise\n", 22000), "needle", "NOT_FOUND", LONG);
+    }
+
+    @Test public void keywordAcrossChunkBoundary() throws Exception {
+        check(repeat("x", 4093) + "\nneedle: edge\n", "needle", "needle: edge", LONG);
+    }
+
+    @Test public void boundedEvidenceCountsSeparators() throws Exception {
+        String answer = run("FLOW_AGENT_LONG", repeat("key: value\n", 1000), "key", LONG);
+        Assert.assertTrue(answer.length() <= 4096, "Evidence budget includes newline separators");
+        Assert.assertTrue(answer.startsWith("key: value"));
+        Assert.assertEquals(answer.split("\n").length, 372);
+    }
+
+    @Test public void oversizedEvidenceIsNotPassedOn() throws Exception {
+        check("needle: " + repeat("x", 5000), "needle", "NOT_FOUND", LONG);
+    }
+
+    @Test public void nestedFlowWorksAsIndependentEntry() throws Exception {
+        Assert.assertEquals(run("FLOW_AGENT_RETRIEVE", "needle: child\n", "needle",
+                new String[]{"AGENT_CHUNK", "AGENT_DRAFT"}), "needle: child");
+    }
+
+    @Test public void releaseSeparatesSuccessiveInputs() throws Exception {
+        check(repeat("noise\n", 22000) + "needle: old\n", "needle", "needle: old", LONG);
+        check("noise\n", "needle", "NOT_FOUND", SHORT);
+    }
+
+    private void check(String context, String question, String answer, String[] path) throws Exception {
+        Assert.assertEquals(run("FLOW_AGENT_LONG", context, question, path), answer);
+    }
+
+    private String run(String flow, String context, String question, String[] path) throws Exception {
+        FlowLongAgentCode.resetTrace();
+        FlowEngine engine = FlowEngine.instance();
+        try {
+            engine.register(FlowConstants.SCOPE_DEFAULT, "context", context)
+                    .register(FlowConstants.SCOPE_DEFAULT, "question", question).run(flow);
+            String output = flow.equals("FLOW_AGENT_LONG") ? "answer" : "draft";
+            String answer = (String) engine.retrieve(FlowConstants.SCOPE_DEFAULT, output);
+            Assert.assertEquals(FlowLongAgentCode.trace(), Arrays.asList(path), "Actual engine node order");
+            System.out.println("STRUCTURE flow=" + flow + " input_chars=" + context.length()
+                    + " answer_chars=" + (answer == null ? -1 : answer.length())
+                    + " path=" + FlowLongAgentCode.trace());
+            return answer;
+        } finally {
+            engine.release();
+            FlowLongAgentCode.resetTrace();
+        }
+    }
+
+    private String repeat(String value, int count) {
+        StringBuilder result = new StringBuilder(value.length() * count);
+        for (int i = 0; i < count; i++) result.append(value);
+        return result.toString();
+    }
+}
diff --git a/flow-test/src/test/java/cc/eamon/open/flow/code/FlowLongAgentCode.java b/flow-test/src/test/java/cc/eamon/open/flow/code/FlowLongAgentCode.java
new file mode 100644
index 0000000..12248c6
--- /dev/null
+++ b/flow-test/src/test/java/cc/eamon/open/flow/code/FlowLongAgentCode.java
@@ -0,0 +1,77 @@
+package cc.eamon.open.flow.code;
+
+import cc.eamon.open.flow.core.FlowEngine;
+import cc.eamon.open.flow.core.stereotype.Flow;
+import java.util.ArrayList;
+import java.util.List;
+
+/** Deterministic adapters for testing the graph without a model API. */
+public class FlowLongAgentCode {
+    private static final int CHUNK_CHARS = 4096;
+    private static final int MAX_EVIDENCE_CHARS = 4096;
+    private static final ThreadLocal<List<String>> TRACE = ThreadLocal.withInitial(ArrayList::new);
+
+    public static void resetTrace() { TRACE.remove(); }
+    public static List<String> trace() { return new ArrayList<>(TRACE.get()); }
+    private static void record(String node) { TRACE.get().add(node); }
+
+    @Flow(value = "AGENT_ROUTE")
+    public void route(String context) {
+        record("AGENT_ROUTE");
+        FlowEngine.instance().register("route", context.length() > CHUNK_CHARS ? 1 : 0);
+    }
+
+    @Flow(value = "AGENT_SHORT")
+    public void shortAnswer(String context, String question) {
+        record("AGENT_SHORT");
+        FlowEngine.instance().register("draft", findLine(context, question));
+    }
+
+    @Flow(value = "AGENT_CHUNK")
+    public void chunk(String context, String question) {
+        record("AGENT_CHUNK");
+        if (question.isEmpty()) throw new IllegalArgumentException("question must not be empty");
+        StringBuilder evidence = new StringBuilder();
+        int previousLine = -1;
+        for (int start = 0; start < context.length(); start += CHUNK_CHARS) {
+            int end = Math.min(context.length(), start + CHUNK_CHARS);
+            // Overlap so a keyword crossing a chunk edge survives.
+            int scanEnd = (int) Math.min((long) context.length(), (long) end + question.length() - 1);
+            String part = context.substring(start, scanEnd);
+            int offset = part.indexOf(question);
+            while (offset >= 0 && offset < end - start) {
+                int hit = start + offset;
+                int lineStart = context.lastIndexOf('\n', hit - 1) + 1;
+                int lineEnd = context.indexOf('\n', hit);
+                if (lineEnd < 0) lineEnd = context.length();
+                int separator = evidence.length() == 0 ? 0 : 1;
+                if (lineStart != previousLine && lineEnd - lineStart + evidence.length() + separator <= MAX_EVIDENCE_CHARS) {
+                    if (separator != 0) evidence.append('\n');
+                    evidence.append(context, lineStart, lineEnd);
+                }
+                previousLine = lineStart;
+                offset = part.indexOf(question, offset + question.length());
+            }
+        }
+        FlowEngine.instance().register("evidence", evidence.length() == 0 ? "NOT_FOUND" : evidence.toString().trim());
+    }
+
+    @Flow(value = "AGENT_DRAFT")
+    public void draft(String evidence) {
+        record("AGENT_DRAFT");
+        FlowEngine.instance().register("draft", evidence);
+    }
+
+    @Flow(value = "AGENT_VERIFY")
+    public void verify(String draft) {
+        record("AGENT_VERIFY");
+        FlowEngine.instance().register("answer", draft == null || draft.isEmpty() ? "NOT_FOUND" : draft);
+    }
+
+    private String findLine(String text, String question) {
+        for (String line : text.split("\\R")) {
+            if (line.contains(question)) return line.trim();
+        }
+        return "NOT_FOUND";
+    }
+}
