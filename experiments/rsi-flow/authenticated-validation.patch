+    @Test public void originalSchedulerClassesAreAvailable() throws Exception {
+        ClassLoader loader = FlowConfig.class.getClassLoader();
+        Assert.assertNotNull(Class.forName("cn.edu.whu.zhuyuhan.scheduler.task.ScheduleTaskRegistrar", false, loader));
+        Assert.assertNotNull(Class.forName("cc.eamon.open.flow.core.stereotype.execute.holder.FlowScheduleHolder", false, loader));
+        Assert.assertNotNull(Class.forName("cc.eamon.open.flow.core.stereotype.execute.holder.FlowScheduleNodeHolder", false, loader));
+    }
+
+    @Test public void originalFileToolsReadsUtf8() throws Exception {
