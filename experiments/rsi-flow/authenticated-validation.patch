+      "results": [{ "name": "draft", "type": "String" }] }
+  ],
+  "routes": [
+    { "source": "start", "target": "AGENT_CHUNK" },
+    { "source": "AGENT_CHUNK", "target": "AGENT_DRAFT" },
+    { "source": "AGENT_DRAFT", "target": "end" }
