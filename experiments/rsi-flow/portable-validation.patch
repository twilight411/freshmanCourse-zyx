diff --git a/flow-test/test_validate_long_agent.py b/flow-test/test_validate_long_agent.py
new file mode 100644
index 0000000..b95b983
--- /dev/null
+++ b/flow-test/test_validate_long_agent.py
@@ -0,0 +1,60 @@
+"""Negative checks ensure malformed graphs are rejected, not just well-formed ones accepted."""
+import copy
+import unittest
+from validate_long_agent import flows, validate, validate_nesting
+
+
+class GraphValidationTest(unittest.TestCase):
+    def parent(self):
+        return copy.deepcopy(flows["FLOW_AGENT_LONG"])
+
+    def test_valid_graphs(self):
+        validate_nesting(flows)
+        for flow in flows.values():
+            validate(flow)
+
+    def test_dangling_route(self):
+        flow = self.parent()
+        flow["routes"][0]["target"] = "MISSING"
+        with self.assertRaisesRegex(AssertionError, "dangling"):
+            validate(flow)
+
+    def test_cycle(self):
+        flow = self.parent()
+        flow["routes"].append({"source": "AGENT_VERIFY", "target": "AGENT_ROUTE"})
+        with self.assertRaisesRegex(AssertionError, "cycle"):
+            validate(flow)
+
+    def test_unreachable_node(self):
+        flow = self.parent()
+        flow["routes"] = [r for r in flow["routes"] if r["target"] != "AGENT_SHORT"]
+        with self.assertRaisesRegex(AssertionError, "unreachable"):
+            validate(flow)
+
+    def test_nested_contract_mismatch(self):
+        flow = self.parent()
+        flow["nodes"][2]["params"] = []
+        with self.assertRaisesRegex(AssertionError, "input mismatch"):
+            validate(flow)
+
+    def test_event_without_code(self):
+        flow = self.parent()
+        flow["nodes"][0]["reference"] = "NO_IMPLEMENTATION"
+        with self.assertRaisesRegex(AssertionError, "event implementation"):
+            validate(flow)
+
+    def test_recursive_subflows(self):
+        registry = copy.deepcopy(flows)
+        registry["FLOW_AGENT_RETRIEVE"]["nodes"].append({"type": "flow", "reference": "FLOW_AGENT_LONG"})
+        with self.assertRaisesRegex(AssertionError, "recursive subflow"):
+            validate_nesting(registry)
+
+    def test_dead_end(self):
+        flow = self.parent()
+        flow["routes"] = [r for r in flow["routes"] if r["source"] != "AGENT_SHORT"]
+        with self.assertRaisesRegex(AssertionError, "cannot reach end"):
+            validate(flow)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/flow-test/validate_long_agent.py b/flow-test/validate_long_agent.py
new file mode 100644
index 0000000..e879330
--- /dev/null
+++ b/flow-test/validate_long_agent.py
@@ -0,0 +1,76 @@
+"""Offline graph checks for the long-context agent example (stdlib only)."""
+import json
+import re
+from pathlib import Path
+
+ROOT = Path(__file__).parent / "src" / "test" / "resources" / "flow"
+FILES = [ROOT / "FLOW_AGENT_LONG" / "flow-agent-long.json",
+         ROOT / "FLOW_AGENT_RETRIEVE" / "flow-agent-retrieve.json"]
+flows = {flow["id"]: flow for path in FILES for flow in [json.loads(path.read_text(encoding="utf-8"))]}
+
+
+def validate(flow):
+    nodes = {node["id"]: node for node in flow["nodes"]}
+    assert len(nodes) == len(flow["nodes"]), "duplicate node ID"
+    graph = {name: [] for name in ["start", *nodes, "end"]}
+    for route in flow["routes"]:
+        assert route["source"] in graph and route["target"] in graph, "dangling route"
+        graph[route["source"]].append(route["target"])
+    visited, stack = set(), set()
+
+    def walk(node):
+        assert node not in stack, "cycle without iteration bound"
+        if node in visited:
+            return
+        stack.add(node)
+        for target in graph[node]:
+            walk(target)
+        stack.remove(node)
+        visited.add(node)
+
+    walk("start")
+    assert visited == set(graph), "unreachable node or end"
+    can_finish = {"end"}
+    while True:
+        expanded = can_finish | {name for name, targets in graph.items() if any(t in can_finish for t in targets)}
+        if expanded == can_finish:
+            break
+        can_finish = expanded
+    assert can_finish == set(graph), "node cannot reach end"
+    code = (Path(__file__).parent / "src/test/java/cc/eamon/open/flow/code/FlowLongAgentCode.java").read_text(encoding="utf-8")
+    events = set(re.findall(r'@Flow\(value\s*=\s*"([^"]+)"\)', code))
+    for node in nodes.values():
+        if node["type"] == "event":
+            assert node["reference"] in events, "missing event implementation"
+        if node["type"] == "flow":
+            assert node["reference"] in flows, "missing nested flow"
+            child = flows[node["reference"]]
+            assert node["params"] == child["params"], "nested input mismatch"
+            assert node["results"] == child["results"], "nested output mismatch"
+    return len(nodes), len(flow["routes"])
+
+
+def validate_nesting(registry):
+    done, active = set(), set()
+
+    def visit(name):
+        assert name not in active, "recursive subflow without iteration bound"
+        if name in done:
+            return
+        active.add(name)
+        for node in registry[name]["nodes"]:
+            if node["type"] == "flow":
+                assert node["reference"] in registry, "missing nested flow"
+                visit(node["reference"])
+        active.remove(name)
+        done.add(name)
+
+    for name in registry:
+        visit(name)
+
+
+if __name__ == "__main__":
+    validate_nesting(flows)
+    for name, flow in flows.items():
+        nodes, routes = validate(flow)
+        print(f"{name}: {nodes} nodes, {routes} routes, reachable DAG")
