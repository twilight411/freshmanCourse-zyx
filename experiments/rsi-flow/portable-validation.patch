@@ -0,0 +1,77 @@
+package cc.eamon.open.flow.code;
+
+import cc.eamon.open.flow.core.FlowEngine;
+import cc.eamon.open.flow.core.stereotype.Flow;
+import java.util.ArrayList;
+import java.util.List;
+
+/** Deterministic adapters for testing the graph without a model API. */
+public class FlowLongAgentCode {
+    private static final int CHUNK_CHARS = 4096;
+    private static final int MAX_EVIDENCE_CHARS = 4096;
+    private static final ThreadLocal<List<String>> TRACE = ThreadLocal.withInitial(ArrayList::new);
+
+    public static void resetTrace() { TRACE.remove(); }
+    public static List<String> trace() { return new ArrayList<>(TRACE.get()); }
+    private static void record(String node) { TRACE.get().add(node); }
+
+    @Flow(value = "AGENT_ROUTE")
+    public void route(String context) {
+        record("AGENT_ROUTE");
+        FlowEngine.instance().register("route", context.length() > CHUNK_CHARS ? 1 : 0);
+    }
+
+    @Flow(value = "AGENT_SHORT")
+    public void shortAnswer(String context, String question) {
+        record("AGENT_SHORT");
+        FlowEngine.instance().register("draft", findLine(context, question));
+    }
+
+    @Flow(value = "AGENT_CHUNK")
+    public void chunk(String context, String question) {
+        record("AGENT_CHUNK");
+        if (question.isEmpty()) throw new IllegalArgumentException("question must not be empty");
+        StringBuilder evidence = new StringBuilder();
+        int previousLine = -1;
+        for (int start = 0; start < context.length(); start += CHUNK_CHARS) {
+            int end = Math.min(context.length(), start + CHUNK_CHARS);
+            // Overlap so a keyword crossing a chunk edge survives.
+            int scanEnd = (int) Math.min((long) context.length(), (long) end + question.length() - 1);
+            String part = context.substring(start, scanEnd);
+            int offset = part.indexOf(question);
+            while (offset >= 0 && offset < end - start) {
+                int hit = start + offset;
+                int lineStart = context.lastIndexOf('\n', hit - 1) + 1;
+                int lineEnd = context.indexOf('\n', hit);
+                if (lineEnd < 0) lineEnd = context.length();
+                int separator = evidence.length() == 0 ? 0 : 1;
+                if (lineStart != previousLine && lineEnd - lineStart + evidence.length() + separator <= MAX_EVIDENCE_CHARS) {
+                    if (separator != 0) evidence.append('\n');
+                    evidence.append(context, lineStart, lineEnd);
+                }
+                previousLine = lineStart;
+                offset = part.indexOf(question, offset + question.length());
+            }
+        }
+        FlowEngine.instance().register("evidence", evidence.length() == 0 ? "NOT_FOUND" : evidence.toString().trim());
+    }
+
+    @Flow(value = "AGENT_DRAFT")
+    public void draft(String evidence) {
+        record("AGENT_DRAFT");
+        FlowEngine.instance().register("draft", evidence);
+    }
+
+    @Flow(value = "AGENT_VERIFY")
+    public void verify(String draft) {
+        record("AGENT_VERIFY");
+        FlowEngine.instance().register("answer", draft == null || draft.isEmpty() ? "NOT_FOUND" : draft);
+    }
+
+    private String findLine(String text, String question) {
+        for (String line : text.split("\\R")) {
+            if (line.contains(question)) return line.trim();
+        }
+        return "NOT_FOUND";
+    }
+}
